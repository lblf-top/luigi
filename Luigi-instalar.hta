<html>
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8">
<title>Instalar Luigi</title>
<HTA:APPLICATION ID="luigi" APPLICATIONNAME="Instalar Luigi" SCROLL="no" SINGLEINSTANCE="yes" MAXIMIZEBUTTON="no" />
<style>
body{font-family:Segoe UI,Arial,sans-serif;background:#1b5e20;color:#fff;margin:0;padding:20px}
h1{margin:0 0 8px}
button{background:#e53935;color:#fff;border:0;padding:14px 24px;font-size:18px;cursor:pointer;margin-top:14px}
#msg{margin-top:16px;font-size:15px;line-height:1.5}
</style>
</head>
<body>
<h1>Luigi</h1>
<div>Instala a linguagem Luigi neste computador.<br>Depois, arquivos <b>.luigi</b> abrem rodando em tela cheia, com dois cliques.</div>
<button onclick="instalar()">Instalar agora</button>
<div id="msg"></div>
<script>
var ABRIR_JS="var fso=new ActiveXObject('Scripting.FileSystemObject');\nvar sh=new ActiveXObject('WScript.Shell');\nfunction lerUtf8(p){var s=new ActiveXObject('ADODB.Stream');s.Type=2;s.Charset='utf-8';s.Open();s.LoadFromFile(p);var t=s.ReadText();s.Close();return t;}\nfunction gravarAscii(p,t){var f=fso.CreateTextFile(p,true,false);f.Write(t);f.Close();}\nfunction esc(c){var h=c.charCodeAt(0).toString(16);return '\\\\u'+('0000'+h).slice(-4);}\nfunction ent(c){return '&#'+c.charCodeAt(0)+';';}\nfunction trocar(t,a,b){return t.split(a).join(b);}\nfunction lit(t){\n  return t.replace(/\\\\/g,'\\\\\\\\').replace(/\"/g,'\\\\\"').replace(/\\r?\\n/g,'\\\\n').replace(/<\\//g,'<\\\\/').replace(/[^\\x20-\\x7e]/g,esc);\n}\nfunction acharNavegador(){\n  var base='\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\App Paths\\\\';\n  var ch=['HKLM'+base+'msedge.exe\\\\','HKCU'+base+'msedge.exe\\\\','HKLM'+base+'chrome.exe\\\\','HKCU'+base+'chrome.exe\\\\'];\n  for(var i=0;i<ch.length;i++){\n    try{var p=sh.RegRead(ch[i]);if(p&&fso.FileExists(p))return p;}catch(e){}\n  }\n  return '';\n}\nfunction principal(){\n  if(WScript.Arguments.length<1)return;\n  var arq=WScript.Arguments(0);\n  var codigo=lerUtf8(arq);\n  var nome=fso.GetFileName(arq);\n  var nomeH=trocar(trocar(trocar(nome,'&','&amp;'),'<','&lt;'),'>','&gt;').replace(/[^\\x20-\\x7e]/g,ent);\n  var pasta=fso.GetParentFolderName(WScript.ScriptFullName);\n  var pai=fso.GetParentFolderName(fso.GetAbsolutePathName(arq));\n  var base='<base href=\"'+encodeURI('file:///'+pai.replace(/\\\\/g,'/')+'/')+'\">';\n  var html=lerUtf8(pasta+'\\\\modelo.html');\n  html=trocar(html,'/*NOME*/',nomeH);\n  html=trocar(html,'/*BASE*/',base);\n  html=trocar(html,'/*CODIGO*/',lit(codigo));\n  var saida=sh.ExpandEnvironmentStrings('%TEMP%')+'\\\\luigi_run.html';\n  gravarAscii(saida,html);\n  var nav=acharNavegador();\n  if(nav){\n    var url=encodeURI('file:///'+saida.replace(/\\\\/g,'/'));\n    sh.Run('\"'+nav+'\" --app=\"'+url+'\" --start-fullscreen',1,false);\n  }else{\n    sh.Run('\"'+saida+'\"',1,false);\n  }\n}\ntry{principal();}catch(e){WScript.Echo('Erro ao abrir o programa Luigi: '+e.message);}\n";
var MODELO_HTML="<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\">/*BASE*/<title>/*NOME*/<\/title>\n<style>html,body{margin:0;height:100%;overflow:hidden;background:#fff}canvas{display:block;width:100vw;height:100vh}<\/style>\n<\/head><body><canvas id=\"c\"><\/canvas>\n<script>\nfunction iniciarLuigi(codigo){\n\"use strict\";\nvar canvas=document.getElementById('c'),ctx=canvas.getContext('2d');\ncanvas.width=Math.max(320,window.innerWidth|0);canvas.height=Math.max(240,window.innerHeight|0);\nvar hasOwn=Object.prototype.hasOwnProperty;\nvar B={};                                   // funcoes e variaveis prontas\nvar TOPO=Object.create(B);\nvar BRK={k:'brk'},CONT={k:'cont'};\nvar passos=0,LIM=5000000;\nvar saidaTexto=[],handlers=[],parado=false,usa3D=false,autoLimpar=true;\nvar corAtual='#000000',fundoCor='#ffffff',fundoImg=null,espessura=2;\nvar imgs={};\n// ---------- entrada ----------\nvar teclas={},apertadas={},mouseDX=0,mouseDY=0,mouseX=0,mouseY=0,botEsq=false,botDir=false,cliqueEsq=false,cliqueDir=false,roda=0;\nfunction nomeTecla(k){\n  k=String(k).toLowerCase();\n  var m={' ':'espaco','arrowup':'cima','arrowdown':'baixo','arrowleft':'esquerda','arrowright':'direita','control':'ctrl','escape':'esc'};\n  return m[k]||k;\n}\nwindow.addEventListener('keydown',function(e){\n  var n=nomeTecla(e.key);\n  if(!teclas[n])apertadas[n]=true;\n  teclas[n]=true;\n  if(n==='espaco'||n==='cima'||n==='baixo'||n==='esquerda'||n==='direita'||n==='tab')e.preventDefault();\n});\nwindow.addEventListener('keyup',function(e){teclas[nomeTecla(e.key)]=false;});\nwindow.addEventListener('blur',function(){teclas={};});\ncanvas.addEventListener('mousemove',function(e){mouseX=e.clientX;mouseY=e.clientY;mouseDX+=e.movementX||0;mouseDY+=e.movementY||0;});\ncanvas.addEventListener('mousedown',function(e){\n  if(usa3D&&document.pointerLockElement!==canvas){if(canvas.requestPointerLock)canvas.requestPointerLock();return;}\n  if(e.button===0){botEsq=true;cliqueEsq=true;}\n  if(e.button===2){botDir=true;cliqueDir=true;}\n});\ncanvas.addEventListener('mouseup',function(e){if(e.button===0)botEsq=false;if(e.button===2)botDir=false;});\ncanvas.addEventListener('contextmenu',function(e){e.preventDefault();});\ncanvas.addEventListener('wheel',function(e){roda+=e.deltaY>0?1:-1;e.preventDefault();});\n// ---------- erros ----------\nfunction erro(msg,n){var e=new Error(msg);e.luigi=true;e.linha=n;return e;}\nfunction traduzir(e){\n  var m=String(e.message),r=/^(\\w+) is not defined$/.exec(m);\n  if(r)return 'a variavel \"'+r[1]+'\" nao existe (crie com /var/)';\n  if(/is not a function/.test(m))return 'isso nao e uma funcao: '+m.replace(' is not a function','');\n  return m;\n}\n// ---------- tradutor de expressoes ----------\nfunction trad(s){\n  var p=s.split(/(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*')/);\n  for(var i=0;i<p.length;i+=2){\n    p[i]=p[i].replace(/\\bou\\b/g,'||').replace(/\\be\\b/g,'&&').replace(/\\bnao\\b/g,'!')\n      .replace(/\\bverdadeiro\\b/g,'true').replace(/\\bfalso\\b/g,'false').replace(/\\bnulo\\b/g,'null');\n  }\n  return p.join('');\n}\nvar cache={};\nfunction compilar(src){\n  var f=cache[src];\n  if(!f){f=new Function('e','with(e){return ('+trad(src)+')}');cache[src]=f;}\n  return f;\n}\nfunction ev(src,esc){return compilar(src)(esc);}\nfunction evLista(src,esc){return compilar('['+src+']')(esc);}\nvar cacheA={};\nfunction atribuir(lhs,val,esc){\n  var f=cacheA[lhs];\n  if(!f){f=new Function('e','__v','with(e){ '+trad(lhs)+' = __v }');cacheA[lhs]=f;}\n  f(esc,val);\n}\nfunction setVar(esc,nome,val){\n  var s=esc;\n  while(s&&s!==B&&s!==Object.prototype&&!hasOwn.call(s,nome))s=Object.getPrototypeOf(s);\n  if(s&&s!==B&&s!==Object.prototype)s[nome]=val;else esc[nome]=val;\n}\nfunction dividirAtrib(a){\n  var q=null,dep=0,i,ch;\n  for(i=0;i<a.length;i++){\n    ch=a[i];\n    if(q){if(ch==='\\\\')i++;else if(ch===q)q=null;continue;}\n    if(ch==='\"'||ch===\"'\"){q=ch;continue;}\n    if('([{'.indexOf(ch)>=0)dep++;\n    else if(')]}'.indexOf(ch)>=0)dep--;\n    else if(ch==='='&&dep===0){\n      if(a[i+1]==='='||a[i+1]==='>'){i++;continue;}\n      if('!<>'.indexOf(a[i-1])>=0)continue;\n      return [a.slice(0,i),a.slice(i+1)];\n    }\n  }\n  return null;\n}\n// ---------- parser ----------\nvar ABRE={se:1,enquanto:1,repetir:1,para:1,paracada:1,funcao:1,classe:1,sempre:1};\nvar FECHA={fim:1,fimse:1,fimenquanto:1,fimrepetir:1,fimpara:1,fimparacada:1,fimfuncao:1,fimclasse:1,fimsempre:1};\nfunction norm(s){return s.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();}\nfunction parsear(cod){\n  var linhas=cod.split(/\\r?\\n/),raiz=[],atual=raiz,pilha=[],i,l,m,c,a,nd,t;\n  for(i=0;i<linhas.length;i++){\n    l=linhas[i].trim();\n    if(!l||l.indexOf('//')===0)continue;\n    m=l.match(/^\\/([^\\/\\s]+)\\/(?:\\s*(.*?)\\s*\\/)?$/);\n    if(!m)throw erro('linha invalida (use /comando/ argumentos /): '+l,i+1);\n    c=norm(m[1]);a=m[2]||'';nd={c:c,a:a,n:i+1};\n    if(ABRE[c]===1){\n      nd.corpo=[];atual.push(nd);pilha.push({nd:nd,pai:atual});\n      if(c==='se'){nd.ramos=[{cond:a,corpo:nd.corpo}];nd.senao=null;}\n      atual=nd.corpo;\n    }else if(c==='senaose'||c==='senao'){\n      t=pilha[pilha.length-1];\n      if(!t||t.nd.c!=='se')throw erro('/'+c+'/ sem /se/',nd.n);\n      if(c==='senaose'){var r={cond:a,corpo:[]};t.nd.ramos.push(r);atual=r.corpo;}\n      else{t.nd.senao=[];atual=t.nd.senao;}\n    }else if(FECHA[c]===1){\n      t=pilha.pop();\n      if(!t)throw erro('/'+c+'/ sem abertura',nd.n);\n      atual=t.pai;\n    }else atual.push(nd);\n  }\n  if(pilha.length)throw erro('falta /fim/ para /'+pilha[pilha.length-1].nd.c+'/',pilha[pilha.length-1].nd.n);\n  return raiz;\n}\n// ---------- execucao ----------\nfunction tick(nd){if(++passos>LIM)throw erro('o programa demorou demais (loop infinito?)',nd.n);}\nfunction exec(lista,esc){\n  for(var i=0;i<lista.length;i++){var r=run(lista[i],esc);if(r)return r;}\n}\nfunction run(nd,esc){\n  tick(nd);\n  try{return exec1(nd,esc);}\n  catch(e){if(!e.luigi){e.luigi=true;e.linha=nd.n;e.message=traduzir(e);}throw e;}\n}\nfunction laco(r){ // 0=continua, 1=sai do laco, 2=propaga\n  if(!r)return 0;if(r===CONT)return 0;if(r===BRK)return 1;return 2;\n}\nfunction cab(a,nd){\n  var m=a.match(/^([A-Za-z_]\\w*)\\s*(?:\\(([^)]*)\\))?\\s*$/);\n  if(!m)throw erro('use /'+nd.c+'/ nome(a, b) /',nd.n);\n  return {nome:m[1],ps:(m[2]||'').split(',').map(function(s){return s.trim();}).filter(Boolean)};\n}\nfunction fmt(x){\n  if(x!==null&&typeof x==='object'){try{return JSON.stringify(x);}catch(e){}}\n  return String(x);\n}\nfunction exec1(nd,esc){\n  var a=nd.a,c=nd.c,v,r,i,m,p;\n  switch(c){\n  case 'criar':\n    v=evLista(a,esc);saidaTexto.push(v.map(fmt).join(' '));\n    if(saidaTexto.length>60)saidaTexto.shift();\n    return;\n  case 'limpartexto':saidaTexto=[];return;\n  case 'var':\n    p=dividirAtrib(a);\n    if(!p)throw erro('use /var/ nome = valor /',nd.n);\n    var lhs=p[0].trim(),rhs=p[1].trim(),op=/[-+*\\/%]$/.exec(lhs);\n    if(op){lhs=lhs.slice(0,-1).trim();rhs='('+lhs+')'+op[0]+'('+rhs+')';}\n    v=ev(rhs,esc);\n    if(/^[A-Za-z_]\\w*$/.test(lhs))setVar(esc,lhs,v);else atribuir(lhs,v,esc);\n    return;\n  case 'ler':\n    var partes=a.split(','),nome=partes[0].trim();\n    var perg=partes.length>1?ev(partes.slice(1).join(','),esc):'Digite '+nome+':';\n    v=window.prompt(String(perg));if(v===null||v===undefined)v='';\n    if(String(v).trim()!==''&&!isNaN(v))v=Number(v);\n    setVar(esc,nome,v);return;\n  case 'se':\n    for(i=0;i<nd.ramos.length;i++)if(ev(nd.ramos[i].cond,esc))return exec(nd.ramos[i].corpo,esc);\n    if(nd.senao)return exec(nd.senao,esc);\n    return;\n  case 'enquanto':\n    while(ev(a,esc)){tick(nd);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\n    return;\n  case 'repetir':\n    var n=Number(ev(a,esc));\n    for(var k=0;k<n;k++){tick(nd);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\n    return;\n  case 'para':\n    m=a.match(/^([A-Za-z_]\\w*)\\s+de\\s+(.+?)\\s+at(?:e|\\u00e9)\\s+(.+?)(?:\\s+passo\\s+(.+))?$/i);\n    if(!m)throw erro('use /para/ i de 1 ate 10 /',nd.n);\n    var ini=ev(m[2],esc),fim=ev(m[3],esc),passo=m[4]?ev(m[4],esc):1;\n    if(passo===0)throw erro('o passo nao pode ser 0',nd.n);\n    for(var x=ini;passo>0?x<=fim:x>=fim;x+=passo){\n      tick(nd);setVar(esc,m[1],x);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;\n    }\n    return;\n  case 'paracada':\n    m=a.match(/^([A-Za-z_]\\w*)\\s+em\\s+(.+)$/);\n    if(!m)throw erro('use /paracada/ item em lista /',nd.n);\n    var L=ev(m[2],esc);\n    for(var it of L){tick(nd);setVar(esc,m[1],it);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\n    return;\n  case 'parar':return BRK;\n  case 'continuar':return CONT;\n  case 'retornar':return {k:'ret',v:a?ev(a,esc):undefined};\n  case 'funcao':\n    var h=cab(a,nd);\n    var fn=function(){\n      var args=arguments,sc=Object.create(esc);\n      h.ps.forEach(function(q,j){sc[q]=args[j];});\n      var rr=exec(nd.corpo,sc);\n      return rr&&rr.k==='ret'?rr.v:undefined;\n    };\n    esc[h.nome]=fn;\n    if(hasOwn.call(esc,'__ctor'))esc.__ctor[h.nome]=fn;\n    return;\n  case 'classe':\n    var hc=cab(a,nd);\n    esc[hc.nome]=function(){\n      var args=arguments,sc=Object.create(esc),obj={};\n      sc.este=obj;sc.__ctor=obj;\n      hc.ps.forEach(function(q,j){sc[q]=args[j];});\n      exec(nd.corpo,sc);\n      return obj;\n    };\n    return;\n  case 'sempre':handlers.push({corpo:nd.corpo,esc:esc});return;\n  case 'chamar':ev(a,esc);return;\n  case 'adicionar':v=evLista(a,esc);v[0].push.apply(v[0],v.slice(1));return;\n  case 'remover':v=evLista(a,esc);v[0].splice(v[1],1);return;\n  // ---- desenho 2D ----\n  case 'fundo':\n    v=ev(a,esc);\n    if(typeof v==='string'&&/(\\.(png|jpe?g|gif|webp|svg|bmp)(\\?.*)?$|^https?:|^data:)/i.test(v)){fundoImg=imagem(v);}\n    else{fundoImg=null;fundoCor=v;}\n    limpar();return;\n  case 'cor':\n    v=evLista(a,esc);\n    corAtual=v.length>=3?'rgb('+v[0]+','+v[1]+','+v[2]+')':String(v[0]);\n    ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;return;\n  case 'espessura':espessura=Number(ev(a,esc));return;\n  case 'limpar':limpar();return;\n  case 'persistir':autoLimpar=false;return;\n  case 'retangulo':v=evLista(a,esc);ctx.fillRect(v[0],v[1],v[2],v[3]);return;\n  case 'circulo':v=evLista(a,esc);ctx.beginPath();ctx.arc(v[0],v[1],Math.max(0,v[2]),0,Math.PI*2);ctx.fill();return;\n  case 'linha':v=evLista(a,esc);ctx.lineWidth=espessura;ctx.beginPath();ctx.moveTo(v[0],v[1]);ctx.lineTo(v[2],v[3]);ctx.stroke();return;\n  case 'escrever':\n    v=evLista(a,esc);ctx.font=(v[3]||20)+'px Consolas, monospace';ctx.textBaseline='top';ctx.fillText(String(v[0]),v[1]||0,v[2]||0);return;\n  case 'imagem':\n    v=evLista(a,esc);var im=imagem(v[0]);\n    if(im.complete&&im.naturalWidth){if(v.length>=5)ctx.drawImage(im,v[1],v[2],v[3],v[4]);else ctx.drawImage(im,v[1]||0,v[2]||0);}\n    return;\n  case 'som':v=evLista(a,esc);try{var au=new Audio(v[0]);au.play();}catch(e){}return;\n  case 'titulo':document.title=String(ev(a,esc));return;\n  // ---- 3D de blocos ----\n  case 'ceu':v=corRGB(ev(a,esc));sky=v;return;\n  case 'resolucao':res=Math.max(1,Number(ev(a,esc))|0);return;\n  case 'campo':fov=Number(ev(a,esc));return;\n  case 'distancia':maxD=Number(ev(a,esc));return;\n  case 'bloco':v=evLista(a,esc);setBloco(v[0],v[1],v[2],v[3]);return;\n  case 'preencher':\n    v=evLista(a,esc);\n    var x1=Math.min(v[0],v[3]),x2=Math.max(v[0],v[3]),y1=Math.min(v[1],v[4]),y2=Math.max(v[1],v[4]),z1=Math.min(v[2],v[5]),z2=Math.max(v[2],v[5]);\n    for(var xx=x1;xx<=x2;xx++)for(var yy=y1;yy<=y2;yy++)for(var zz=z1;zz<=z2;zz++)setBloco(xx,yy,zz,v[6]);\n    return;\n  case 'camera':v=evLista(a,esc);usa3D=true;cam.x=v[0];cam.y=v[1];cam.z=v[2];cam.giro=v[3]||0;cam.inc=v[4]||0;return;\n  case 'desenhar3d':usa3D=true;desenhar3D();return;\n  default:throw erro('comando desconhecido: /'+c+'/',nd.n);\n  }\n}\n// ---------- imagens / desenho ----------\nfunction imagem(src){\n  var im=imgs[src];\n  if(!im){im=new Image();im.src=src;imgs[src]=im;}\n  return im;\n}\nfunction limpar(){\n  if(fundoImg&&fundoImg.complete&&fundoImg.naturalWidth)ctx.drawImage(fundoImg,0,0,canvas.width,canvas.height);\n  else{ctx.fillStyle=fundoCor;ctx.fillRect(0,0,canvas.width,canvas.height);}\n  ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;\n}\nfunction desenharTexto(){\n  if(!saidaTexto.length)return;\n  ctx.save();ctx.font='16px Consolas, monospace';ctx.textBaseline='top';ctx.fillStyle='#000';\n  for(var i=0;i<saidaTexto.length;i++)ctx.fillText(saidaTexto[i],8,6+i*20);\n  ctx.restore();\n}\n// ---------- mundo 3D ----------\nvar GX=128,GY=64,GZ=128,grade=new Uint8Array(GX*GY*GZ);\nvar pal=[null],palNome=['ar'],palMap={};\nvar cam={x:0,y:0,z:0,giro:0,inc:0},sky=[135,206,235],res=5,fov=70,maxD=48;\nvar off=null,octx=null,img3=null,px32=null,ctxCor=null;\nfunction corRGB(c){\n  if(Array.isArray(c))return c;\n  c=String(c);\n  var h=c;\n  if(c.charAt(0)!=='#'){\n    if(!ctxCor)ctxCor=document.createElement('canvas').getContext('2d');\n    ctxCor.fillStyle='#000';ctxCor.fillStyle=c;h=String(ctxCor.fillStyle);\n  }\n  var m;\n  if(h.charAt(0)==='#'){\n    if(h.length===4)h='#'+h[1]+h[1]+h[2]+h[2]+h[3]+h[3];\n    if(h.length===7)return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];\n  }\n  m=/rgba?\\(\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)/.exec(h);\n  if(m)return [+m[1],+m[2],+m[3]];\n  return [128,128,128];\n}\nfunction setBloco(x,y,z,c){\n  x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);\n  if(x<0||x>=GX||y<0||y>=GY||z<0||z>=GZ)return;\n  var idx=x+GX*(z+GZ*y);\n  if(c===undefined||c===null||c===0||c===''||c==='ar'){grade[idx]=0;return;}\n  var key=String(c),k=palMap[key];\n  if(!k){\n    if(pal.length>=255)throw new Error('cores demais nos blocos (maximo 254)');\n    pal.push(corRGB(c));palNome.push(key);k=pal.length-1;palMap[key]=k;\n  }\n  grade[idx]=k;\n}\nfunction getBloco(x,y,z){\n  x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);\n  if(x<0||x>=GX||y<0||y>=GY||z<0||z>=GZ)return 'ar';\n  return palNome[grade[x+GX*(z+GZ*y)]];\n}\nfunction base3(){\n  var yw=cam.giro*Math.PI/180,pt=cam.inc*Math.PI/180,sy=Math.sin(yw),cy=Math.cos(yw),sp=Math.sin(pt),cp=Math.cos(pt);\n  return {fx:sy*cp,fy:sp,fz:cy*cp,rx:cy,ry:0,rz:-sy,ux:-sy*sp,uy:cp,uz:-cy*sp};\n}\nfunction olhar(){\n  var b=base3(),ox=cam.x,oy=cam.y,oz=cam.z,dx=b.fx,dy=b.fy,dz=b.fz;\n  var mx=Math.floor(ox),my=Math.floor(oy),mz=Math.floor(oz);\n  var sx=dx<0?-1:1,sy=dy<0?-1:1,sz=dz<0?-1:1;\n  var ddx=dx===0?Infinity:Math.abs(1/dx),ddy=dy===0?Infinity:Math.abs(1/dy),ddz=dz===0?Infinity:Math.abs(1/dz);\n  var tx=dx===0?Infinity:(dx>0?mx+1-ox:ox-mx)*ddx,ty=dy===0?Infinity:(dy>0?my+1-oy:oy-my)*ddy,tz=dz===0?Infinity:(dz>0?mz+1-oz:oz-mz)*ddz;\n  var t=0,px,py,pz;\n  for(var i=0;i<64;i++){\n    px=mx;py=my;pz=mz;\n    if(tx<ty){if(tx<tz){mx+=sx;t=tx;tx+=ddx;}else{mz+=sz;t=tz;tz+=ddz;}}\n    else{if(ty<tz){my+=sy;t=ty;ty+=ddy;}else{mz+=sz;t=tz;tz+=ddz;}}\n    if(t>6)break;\n    if(mx>=0&&mx<GX&&my>=0&&my<GY&&mz>=0&&mz<GZ&&grade[mx+GX*(mz+GZ*my)])\n      return {achou:true,x:mx,y:my,z:mz,ax:px,ay:py,az:pz};\n  }\n  return {achou:false,x:0,y:0,z:0,ax:0,ay:0,az:0};\n}\nfunction desenhar3D(){\n  var w=Math.max(1,Math.ceil(canvas.width/res)),h=Math.max(1,Math.ceil(canvas.height/res));\n  if(!off||off.width!==w||off.height!==h){\n    off=document.createElement('canvas');off.width=w;off.height=h;octx=off.getContext('2d');\n    img3=octx.createImageData(w,h);px32=new Uint32Array(img3.data.buffer);\n  }\n  var b=base3(),ox=cam.x,oy=cam.y,oz=cam.z,ft=Math.tan(fov*Math.PI/360),asp=w/h;\n  var sR=sky[0],sG=sky[1],sB=sky[2],idx=0;\n  var mx0=Math.floor(ox),my0=Math.floor(oy),mz0=Math.floor(oz);\n  for(var py=0;py<h;py++){\n    var v=(1-2*(py+0.5)/h)*ft,gr=0.8+0.2*(py/h);\n    var skyPix=(255<<24)|((sB*gr)<<16)|((sG*gr)<<8)|(sR*gr);\n    for(var pxl=0;pxl<w;pxl++,idx++){\n      var u=(2*(pxl+0.5)/w-1)*ft*asp;\n      var dx=b.fx+b.rx*u+b.ux*v,dy=b.fy+b.ry*u+b.uy*v,dz=b.fz+b.rz*u+b.uz*v;\n      var mx=mx0,my=my0,mz=mz0;\n      var sx=dx<0?-1:1,sy=dy<0?-1:1,sz=dz<0?-1:1;\n      var ddx=dx===0?Infinity:Math.abs(1/dx),ddy=dy===0?Infinity:Math.abs(1/dy),ddz=dz===0?Infinity:Math.abs(1/dz);\n      var tx=dx===0?Infinity:(dx>0?mx+1-ox:ox-mx)*ddx,ty=dy===0?Infinity:(dy>0?my+1-oy:oy-my)*ddy,tz=dz===0?Infinity:(dz>0?mz+1-oz:oz-mz)*ddz;\n      var t=0,side=0,hit=0;\n      for(var s=0;s<96;s++){\n        if(tx<ty){if(tx<tz){mx+=sx;t=tx;tx+=ddx;side=0;}else{mz+=sz;t=tz;tz+=ddz;side=2;}}\n        else{if(ty<tz){my+=sy;t=ty;ty+=ddy;side=1;}else{mz+=sz;t=tz;tz+=ddz;side=2;}}\n        if(t>maxD)break;\n        if(mx>=0&&mx<GX&&my>=0&&my<GY&&mz>=0&&mz<GZ){hit=grade[mx+GX*(mz+GZ*my)];if(hit)break;}\n      }\n      if(!hit){px32[idx]=skyPix;continue;}\n      var f=side===1?(sy<0?1:0.55):(side===0?0.8:0.65);\n      var f1,f2;\n      if(side===0){f1=oy+dy*t;f2=oz+dz*t;}else if(side===1){f1=ox+dx*t;f2=oz+dz*t;}else{f1=ox+dx*t;f2=oy+dy*t;}\n      f1-=Math.floor(f1);f2-=Math.floor(f2);\n      if(Math.min(f1,1-f1,f2,1-f2)<0.04)f*=0.78;\n      f*=0.9+0.1*(((mx*73856093)^(my*19349663)^(mz*83492791))&255)/255;\n      var fg=t/maxD;fg=fg*fg*0.7;\n      var c=pal[hit];\n      var r=(c[0]*f)*(1-fg)+sR*fg,g=(c[1]*f)*(1-fg)+sG*fg,bl=(c[2]*f)*(1-fg)+sB*fg;\n      px32[idx]=(255<<24)|(bl<<16)|(g<<8)|r;\n    }\n  }\n  octx.putImageData(img3,0,0);\n  ctx.imageSmoothingEnabled=false;\n  ctx.drawImage(off,0,0,canvas.width,canvas.height);\n  ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;\n}\n// ---------- funcoes prontas ----------\nB.pi=Math.PI;B.largura=canvas.width;B.altura=canvas.height;B.dt=0.016;\nB.mouseX=0;B.mouseY=0;B.mouseDX=0;B.mouseDY=0;B.clicando=false;B.clicandoDireito=false;B.clicouEsq=false;B.clicouDir=false;B.rodinha=0;\nB.aleatorio=function(a,b){if(b===undefined){b=a-1;a=0;}return a+Math.floor(Math.random()*(b-a+1));};\nB.piso=Math.floor;B.teto=Math.ceil;B.arredondar=Math.round;B.raiz=Math.sqrt;B.potencia=Math.pow;B.abs=Math.abs;B.minimo=Math.min;B.maximo=Math.max;\nB.seno=function(g){return Math.sin(g*Math.PI/180);};\nB.cosseno=function(g){return Math.cos(g*Math.PI/180);};\nB.tangente=function(g){return Math.tan(g*Math.PI/180);};\nB.tamanho=function(x){return x.length;};\nB.texto=function(x){return fmt(x);};\nB.numero=function(x){return Number(x);};\nB.lista=function(n,v){var l=[];for(var i=0;i<n;i++)l.push(v===undefined?0:v);return l;};\nB.agora=function(){return Date.now();};\nB.tecla=function(n){return !!teclas[norm(n)];};\nB.apertou=function(n){return !!apertadas[norm(n)];};\nB.bloco=getBloco;\nB.olhar=olhar;\n// ---------- laco principal ----------\nfunction mostrarErro(e){\n  parado=true;\n  var msg=(e.linha?'Erro na linha '+e.linha+': ':'Erro: ')+traduzir(e);\n  try{console.error(msg);}catch(x){}\n  ctx.save();ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);\n  ctx.fillStyle='#c62828';ctx.font='20px Consolas, monospace';ctx.textBaseline='top';\n  var palavras=msg.split(' '),linha='',y=20;\n  for(var i=0;i<palavras.length;i++){\n    var t=linha?linha+' '+palavras[i]:palavras[i];\n    if(ctx.measureText(t).width>canvas.width-40&&linha){ctx.fillText(linha,20,y);y+=28;linha=palavras[i];}else linha=t;\n  }\n  ctx.fillText(linha,20,y);ctx.restore();\n}\nvar ultimo=0;\nfunction quadro(ts){\n  if(parado)return;\n  var d=ultimo?Math.min(0.1,(ts-ultimo)/1000):0.016;ultimo=ts;\n  B.dt=d;B.mouseX=mouseX;B.mouseY=mouseY;B.mouseDX=mouseDX;B.mouseDY=mouseDY;\n  B.clicando=botEsq;B.clicandoDireito=botDir;B.clicouEsq=cliqueEsq;B.clicouDir=cliqueDir;B.rodinha=roda;\n  passos=0;\n  try{\n    if(autoLimpar)limpar();\n    for(var i=0;i<handlers.length;i++)exec(handlers[i].corpo,handlers[i].esc);\n  }catch(e){mostrarErro(e);return;}\n  desenharTexto();\n  mouseDX=0;mouseDY=0;cliqueEsq=false;cliqueDir=false;roda=0;apertadas={};\n  requestAnimationFrame(quadro);\n}\nfunction comecar(){\n  try{\n    var arvore=parsear(codigo);\n    limpar();\n    passos=0;\n    exec(arvore,TOPO);\n    desenharTexto();\n    if(handlers.length)requestAnimationFrame(quadro);\n  }catch(e){mostrarErro(e);}\n}\n// carrega antes as imagens citadas no codigo\nvar achadas=[],rx=/[\"']([^\"']+\\.(?:png|jpe?g|gif|webp|svg|bmp)(?:\\?[^\"']*)?)[\"']/gi,mm;\nwhile((mm=rx.exec(codigo)))achadas.push(mm[1]);\nif(!achadas.length)comecar();\nelse{\n  var falta=achadas.length,feito=false;\n  var fim=function(){if(!feito&&--falta<=0){feito=true;comecar();}};\n  achadas.forEach(function(s){var im=imagem(s);if(im.complete)fim();else{im.onload=fim;im.onerror=fim;}});\n  setTimeout(function(){if(!feito){feito=true;comecar();}},3000);\n}\nwindow.__luigi={quadro:quadro,teclas:teclas,B:B};\n}\n\nvar CODIGO=\"/*CODIGO*/\";\niniciarLuigi(CODIGO);\n<\/script><\/body><\/html>\n";
var MINI_HTML="<!DOCTYPE html><meta charset=utf-8><title>Luigi<\/title>\n<style>*{box-sizing:border-box}body{margin:0;background:#000;display:flex;flex-direction:column;height:100vh}textarea{flex:1;background:#000;color:#0f0;border:0;outline:0;padding:12px;font:18px Consolas,monospace;resize:none}button,label{background:#222;color:#0f0;border:1px solid #0f0;padding:10px;font:16px Consolas,monospace;cursor:pointer;text-align:center}<\/style>\n<button onclick=I()>Instalar<\/button><textarea id=t spellcheck=false><\/textarea><label>Importar<input type=file hidden onchange=M(this)><\/label>\n<script>\nvar TPL=\"<!DOCTYPE html>\\n<html><head><meta charset=\\\"utf-8\\\">/*BASE*/<title>/*NOME*/<\\/title>\\n<style>html,body{margin:0;height:100%;overflow:hidden;background:#fff}canvas{display:block;width:100vw;height:100vh}<\\/style>\\n<\\/head><body><canvas id=\\\"c\\\"><\\/canvas>\\n<script>\\nfunction iniciarLuigi(codigo){\\n\\\"use strict\\\";\\nvar canvas=document.getElementById('c'),ctx=canvas.getContext('2d');\\ncanvas.width=Math.max(320,window.innerWidth|0);canvas.height=Math.max(240,window.innerHeight|0);\\nvar hasOwn=Object.prototype.hasOwnProperty;\\nvar B={};                                   // funcoes e variaveis prontas\\nvar TOPO=Object.create(B);\\nvar BRK={k:'brk'},CONT={k:'cont'};\\nvar passos=0,LIM=5000000;\\nvar saidaTexto=[],handlers=[],parado=false,usa3D=false,autoLimpar=true;\\nvar corAtual='#000000',fundoCor='#ffffff',fundoImg=null,espessura=2;\\nvar imgs={};\\n// ---------- entrada ----------\\nvar teclas={},apertadas={},mouseDX=0,mouseDY=0,mouseX=0,mouseY=0,botEsq=false,botDir=false,cliqueEsq=false,cliqueDir=false,roda=0;\\nfunction nomeTecla(k){\\n  k=String(k).toLowerCase();\\n  var m={' ':'espaco','arrowup':'cima','arrowdown':'baixo','arrowleft':'esquerda','arrowright':'direita','control':'ctrl','escape':'esc'};\\n  return m[k]||k;\\n}\\nwindow.addEventListener('keydown',function(e){\\n  var n=nomeTecla(e.key);\\n  if(!teclas[n])apertadas[n]=true;\\n  teclas[n]=true;\\n  if(n==='espaco'||n==='cima'||n==='baixo'||n==='esquerda'||n==='direita'||n==='tab')e.preventDefault();\\n});\\nwindow.addEventListener('keyup',function(e){teclas[nomeTecla(e.key)]=false;});\\nwindow.addEventListener('blur',function(){teclas={};});\\ncanvas.addEventListener('mousemove',function(e){mouseX=e.clientX;mouseY=e.clientY;mouseDX+=e.movementX||0;mouseDY+=e.movementY||0;});\\ncanvas.addEventListener('mousedown',function(e){\\n  if(usa3D&&document.pointerLockElement!==canvas){if(canvas.requestPointerLock)canvas.requestPointerLock();return;}\\n  if(e.button===0){botEsq=true;cliqueEsq=true;}\\n  if(e.button===2){botDir=true;cliqueDir=true;}\\n});\\ncanvas.addEventListener('mouseup',function(e){if(e.button===0)botEsq=false;if(e.button===2)botDir=false;});\\ncanvas.addEventListener('contextmenu',function(e){e.preventDefault();});\\ncanvas.addEventListener('wheel',function(e){roda+=e.deltaY>0?1:-1;e.preventDefault();});\\n// ---------- erros ----------\\nfunction erro(msg,n){var e=new Error(msg);e.luigi=true;e.linha=n;return e;}\\nfunction traduzir(e){\\n  var m=String(e.message),r=/^(\\\\w+) is not defined$/.exec(m);\\n  if(r)return 'a variavel \\\"'+r[1]+'\\\" nao existe (crie com /var/)';\\n  if(/is not a function/.test(m))return 'isso nao e uma funcao: '+m.replace(' is not a function','');\\n  return m;\\n}\\n// ---------- tradutor de expressoes ----------\\nfunction trad(s){\\n  var p=s.split(/(\\\"(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*\\\"|'(?:[^'\\\\\\\\]|\\\\\\\\.)*')/);\\n  for(var i=0;i<p.length;i+=2){\\n    p[i]=p[i].replace(/\\\\bou\\\\b/g,'||').replace(/\\\\be\\\\b/g,'&&').replace(/\\\\bnao\\\\b/g,'!')\\n      .replace(/\\\\bverdadeiro\\\\b/g,'true').replace(/\\\\bfalso\\\\b/g,'false').replace(/\\\\bnulo\\\\b/g,'null');\\n  }\\n  return p.join('');\\n}\\nvar cache={};\\nfunction compilar(src){\\n  var f=cache[src];\\n  if(!f){f=new Function('e','with(e){return ('+trad(src)+')}');cache[src]=f;}\\n  return f;\\n}\\nfunction ev(src,esc){return compilar(src)(esc);}\\nfunction evLista(src,esc){return compilar('['+src+']')(esc);}\\nvar cacheA={};\\nfunction atribuir(lhs,val,esc){\\n  var f=cacheA[lhs];\\n  if(!f){f=new Function('e','__v','with(e){ '+trad(lhs)+' = __v }');cacheA[lhs]=f;}\\n  f(esc,val);\\n}\\nfunction setVar(esc,nome,val){\\n  var s=esc;\\n  while(s&&s!==B&&s!==Object.prototype&&!hasOwn.call(s,nome))s=Object.getPrototypeOf(s);\\n  if(s&&s!==B&&s!==Object.prototype)s[nome]=val;else esc[nome]=val;\\n}\\nfunction dividirAtrib(a){\\n  var q=null,dep=0,i,ch;\\n  for(i=0;i<a.length;i++){\\n    ch=a[i];\\n    if(q){if(ch==='\\\\\\\\')i++;else if(ch===q)q=null;continue;}\\n    if(ch==='\\\"'||ch===\\\"'\\\"){q=ch;continue;}\\n    if('([{'.indexOf(ch)>=0)dep++;\\n    else if(')]}'.indexOf(ch)>=0)dep--;\\n    else if(ch==='='&&dep===0){\\n      if(a[i+1]==='='||a[i+1]==='>'){i++;continue;}\\n      if('!<>'.indexOf(a[i-1])>=0)continue;\\n      return [a.slice(0,i),a.slice(i+1)];\\n    }\\n  }\\n  return null;\\n}\\n// ---------- parser ----------\\nvar ABRE={se:1,enquanto:1,repetir:1,para:1,paracada:1,funcao:1,classe:1,sempre:1};\\nvar FECHA={fim:1,fimse:1,fimenquanto:1,fimrepetir:1,fimpara:1,fimparacada:1,fimfuncao:1,fimclasse:1,fimsempre:1};\\nfunction norm(s){return s.normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g,'').toLowerCase();}\\nfunction parsear(cod){\\n  var linhas=cod.split(/\\\\r?\\\\n/),raiz=[],atual=raiz,pilha=[],i,l,m,c,a,nd,t;\\n  for(i=0;i<linhas.length;i++){\\n    l=linhas[i].trim();\\n    if(!l||l.indexOf('//')===0)continue;\\n    m=l.match(/^\\\\/([^\\\\/\\\\s]+)\\\\/(?:\\\\s*(.*?)\\\\s*\\\\/)?$/);\\n    if(!m)throw erro('linha invalida (use /comando/ argumentos /): '+l,i+1);\\n    c=norm(m[1]);a=m[2]||'';nd={c:c,a:a,n:i+1};\\n    if(ABRE[c]===1){\\n      nd.corpo=[];atual.push(nd);pilha.push({nd:nd,pai:atual});\\n      if(c==='se'){nd.ramos=[{cond:a,corpo:nd.corpo}];nd.senao=null;}\\n      atual=nd.corpo;\\n    }else if(c==='senaose'||c==='senao'){\\n      t=pilha[pilha.length-1];\\n      if(!t||t.nd.c!=='se')throw erro('/'+c+'/ sem /se/',nd.n);\\n      if(c==='senaose'){var r={cond:a,corpo:[]};t.nd.ramos.push(r);atual=r.corpo;}\\n      else{t.nd.senao=[];atual=t.nd.senao;}\\n    }else if(FECHA[c]===1){\\n      t=pilha.pop();\\n      if(!t)throw erro('/'+c+'/ sem abertura',nd.n);\\n      atual=t.pai;\\n    }else atual.push(nd);\\n  }\\n  if(pilha.length)throw erro('falta /fim/ para /'+pilha[pilha.length-1].nd.c+'/',pilha[pilha.length-1].nd.n);\\n  return raiz;\\n}\\n// ---------- execucao ----------\\nfunction tick(nd){if(++passos>LIM)throw erro('o programa demorou demais (loop infinito?)',nd.n);}\\nfunction exec(lista,esc){\\n  for(var i=0;i<lista.length;i++){var r=run(lista[i],esc);if(r)return r;}\\n}\\nfunction run(nd,esc){\\n  tick(nd);\\n  try{return exec1(nd,esc);}\\n  catch(e){if(!e.luigi){e.luigi=true;e.linha=nd.n;e.message=traduzir(e);}throw e;}\\n}\\nfunction laco(r){ // 0=continua, 1=sai do laco, 2=propaga\\n  if(!r)return 0;if(r===CONT)return 0;if(r===BRK)return 1;return 2;\\n}\\nfunction cab(a,nd){\\n  var m=a.match(/^([A-Za-z_]\\\\w*)\\\\s*(?:\\\\(([^)]*)\\\\))?\\\\s*$/);\\n  if(!m)throw erro('use /'+nd.c+'/ nome(a, b) /',nd.n);\\n  return {nome:m[1],ps:(m[2]||'').split(',').map(function(s){return s.trim();}).filter(Boolean)};\\n}\\nfunction fmt(x){\\n  if(x!==null&&typeof x==='object'){try{return JSON.stringify(x);}catch(e){}}\\n  return String(x);\\n}\\nfunction exec1(nd,esc){\\n  var a=nd.a,c=nd.c,v,r,i,m,p;\\n  switch(c){\\n  case 'criar':\\n    v=evLista(a,esc);saidaTexto.push(v.map(fmt).join(' '));\\n    if(saidaTexto.length>60)saidaTexto.shift();\\n    return;\\n  case 'limpartexto':saidaTexto=[];return;\\n  case 'var':\\n    p=dividirAtrib(a);\\n    if(!p)throw erro('use /var/ nome = valor /',nd.n);\\n    var lhs=p[0].trim(),rhs=p[1].trim(),op=/[-+*\\\\/%]$/.exec(lhs);\\n    if(op){lhs=lhs.slice(0,-1).trim();rhs='('+lhs+')'+op[0]+'('+rhs+')';}\\n    v=ev(rhs,esc);\\n    if(/^[A-Za-z_]\\\\w*$/.test(lhs))setVar(esc,lhs,v);else atribuir(lhs,v,esc);\\n    return;\\n  case 'ler':\\n    var partes=a.split(','),nome=partes[0].trim();\\n    var perg=partes.length>1?ev(partes.slice(1).join(','),esc):'Digite '+nome+':';\\n    v=window.prompt(String(perg));if(v===null||v===undefined)v='';\\n    if(String(v).trim()!==''&&!isNaN(v))v=Number(v);\\n    setVar(esc,nome,v);return;\\n  case 'se':\\n    for(i=0;i<nd.ramos.length;i++)if(ev(nd.ramos[i].cond,esc))return exec(nd.ramos[i].corpo,esc);\\n    if(nd.senao)return exec(nd.senao,esc);\\n    return;\\n  case 'enquanto':\\n    while(ev(a,esc)){tick(nd);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\\n    return;\\n  case 'repetir':\\n    var n=Number(ev(a,esc));\\n    for(var k=0;k<n;k++){tick(nd);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\\n    return;\\n  case 'para':\\n    m=a.match(/^([A-Za-z_]\\\\w*)\\\\s+de\\\\s+(.+?)\\\\s+at(?:e|\\\\u00e9)\\\\s+(.+?)(?:\\\\s+passo\\\\s+(.+))?$/i);\\n    if(!m)throw erro('use /para/ i de 1 ate 10 /',nd.n);\\n    var ini=ev(m[2],esc),fim=ev(m[3],esc),passo=m[4]?ev(m[4],esc):1;\\n    if(passo===0)throw erro('o passo nao pode ser 0',nd.n);\\n    for(var x=ini;passo>0?x<=fim:x>=fim;x+=passo){\\n      tick(nd);setVar(esc,m[1],x);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;\\n    }\\n    return;\\n  case 'paracada':\\n    m=a.match(/^([A-Za-z_]\\\\w*)\\\\s+em\\\\s+(.+)$/);\\n    if(!m)throw erro('use /paracada/ item em lista /',nd.n);\\n    var L=ev(m[2],esc);\\n    for(var it of L){tick(nd);setVar(esc,m[1],it);r=exec(nd.corpo,esc);i=laco(r);if(i===1)break;if(i===2)return r;}\\n    return;\\n  case 'parar':return BRK;\\n  case 'continuar':return CONT;\\n  case 'retornar':return {k:'ret',v:a?ev(a,esc):undefined};\\n  case 'funcao':\\n    var h=cab(a,nd);\\n    var fn=function(){\\n      var args=arguments,sc=Object.create(esc);\\n      h.ps.forEach(function(q,j){sc[q]=args[j];});\\n      var rr=exec(nd.corpo,sc);\\n      return rr&&rr.k==='ret'?rr.v:undefined;\\n    };\\n    esc[h.nome]=fn;\\n    if(hasOwn.call(esc,'__ctor'))esc.__ctor[h.nome]=fn;\\n    return;\\n  case 'classe':\\n    var hc=cab(a,nd);\\n    esc[hc.nome]=function(){\\n      var args=arguments,sc=Object.create(esc),obj={};\\n      sc.este=obj;sc.__ctor=obj;\\n      hc.ps.forEach(function(q,j){sc[q]=args[j];});\\n      exec(nd.corpo,sc);\\n      return obj;\\n    };\\n    return;\\n  case 'sempre':handlers.push({corpo:nd.corpo,esc:esc});return;\\n  case 'chamar':ev(a,esc);return;\\n  case 'adicionar':v=evLista(a,esc);v[0].push.apply(v[0],v.slice(1));return;\\n  case 'remover':v=evLista(a,esc);v[0].splice(v[1],1);return;\\n  // ---- desenho 2D ----\\n  case 'fundo':\\n    v=ev(a,esc);\\n    if(typeof v==='string'&&/(\\\\.(png|jpe?g|gif|webp|svg|bmp)(\\\\?.*)?$|^https?:|^data:)/i.test(v)){fundoImg=imagem(v);}\\n    else{fundoImg=null;fundoCor=v;}\\n    limpar();return;\\n  case 'cor':\\n    v=evLista(a,esc);\\n    corAtual=v.length>=3?'rgb('+v[0]+','+v[1]+','+v[2]+')':String(v[0]);\\n    ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;return;\\n  case 'espessura':espessura=Number(ev(a,esc));return;\\n  case 'limpar':limpar();return;\\n  case 'persistir':autoLimpar=false;return;\\n  case 'retangulo':v=evLista(a,esc);ctx.fillRect(v[0],v[1],v[2],v[3]);return;\\n  case 'circulo':v=evLista(a,esc);ctx.beginPath();ctx.arc(v[0],v[1],Math.max(0,v[2]),0,Math.PI*2);ctx.fill();return;\\n  case 'linha':v=evLista(a,esc);ctx.lineWidth=espessura;ctx.beginPath();ctx.moveTo(v[0],v[1]);ctx.lineTo(v[2],v[3]);ctx.stroke();return;\\n  case 'escrever':\\n    v=evLista(a,esc);ctx.font=(v[3]||20)+'px Consolas, monospace';ctx.textBaseline='top';ctx.fillText(String(v[0]),v[1]||0,v[2]||0);return;\\n  case 'imagem':\\n    v=evLista(a,esc);var im=imagem(v[0]);\\n    if(im.complete&&im.naturalWidth){if(v.length>=5)ctx.drawImage(im,v[1],v[2],v[3],v[4]);else ctx.drawImage(im,v[1]||0,v[2]||0);}\\n    return;\\n  case 'som':v=evLista(a,esc);try{var au=new Audio(v[0]);au.play();}catch(e){}return;\\n  case 'titulo':document.title=String(ev(a,esc));return;\\n  // ---- 3D de blocos ----\\n  case 'ceu':v=corRGB(ev(a,esc));sky=v;return;\\n  case 'resolucao':res=Math.max(1,Number(ev(a,esc))|0);return;\\n  case 'campo':fov=Number(ev(a,esc));return;\\n  case 'distancia':maxD=Number(ev(a,esc));return;\\n  case 'bloco':v=evLista(a,esc);setBloco(v[0],v[1],v[2],v[3]);return;\\n  case 'preencher':\\n    v=evLista(a,esc);\\n    var x1=Math.min(v[0],v[3]),x2=Math.max(v[0],v[3]),y1=Math.min(v[1],v[4]),y2=Math.max(v[1],v[4]),z1=Math.min(v[2],v[5]),z2=Math.max(v[2],v[5]);\\n    for(var xx=x1;xx<=x2;xx++)for(var yy=y1;yy<=y2;yy++)for(var zz=z1;zz<=z2;zz++)setBloco(xx,yy,zz,v[6]);\\n    return;\\n  case 'camera':v=evLista(a,esc);usa3D=true;cam.x=v[0];cam.y=v[1];cam.z=v[2];cam.giro=v[3]||0;cam.inc=v[4]||0;return;\\n  case 'desenhar3d':usa3D=true;desenhar3D();return;\\n  default:throw erro('comando desconhecido: /'+c+'/',nd.n);\\n  }\\n}\\n// ---------- imagens / desenho ----------\\nfunction imagem(src){\\n  var im=imgs[src];\\n  if(!im){im=new Image();im.src=src;imgs[src]=im;}\\n  return im;\\n}\\nfunction limpar(){\\n  if(fundoImg&&fundoImg.complete&&fundoImg.naturalWidth)ctx.drawImage(fundoImg,0,0,canvas.width,canvas.height);\\n  else{ctx.fillStyle=fundoCor;ctx.fillRect(0,0,canvas.width,canvas.height);}\\n  ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;\\n}\\nfunction desenharTexto(){\\n  if(!saidaTexto.length)return;\\n  ctx.save();ctx.font='16px Consolas, monospace';ctx.textBaseline='top';ctx.fillStyle='#000';\\n  for(var i=0;i<saidaTexto.length;i++)ctx.fillText(saidaTexto[i],8,6+i*20);\\n  ctx.restore();\\n}\\n// ---------- mundo 3D ----------\\nvar GX=128,GY=64,GZ=128,grade=new Uint8Array(GX*GY*GZ);\\nvar pal=[null],palNome=['ar'],palMap={};\\nvar cam={x:0,y:0,z:0,giro:0,inc:0},sky=[135,206,235],res=5,fov=70,maxD=48;\\nvar off=null,octx=null,img3=null,px32=null,ctxCor=null;\\nfunction corRGB(c){\\n  if(Array.isArray(c))return c;\\n  c=String(c);\\n  var h=c;\\n  if(c.charAt(0)!=='#'){\\n    if(!ctxCor)ctxCor=document.createElement('canvas').getContext('2d');\\n    ctxCor.fillStyle='#000';ctxCor.fillStyle=c;h=String(ctxCor.fillStyle);\\n  }\\n  var m;\\n  if(h.charAt(0)==='#'){\\n    if(h.length===4)h='#'+h[1]+h[1]+h[2]+h[2]+h[3]+h[3];\\n    if(h.length===7)return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];\\n  }\\n  m=/rgba?\\\\(\\\\s*(\\\\d+)\\\\s*,\\\\s*(\\\\d+)\\\\s*,\\\\s*(\\\\d+)/.exec(h);\\n  if(m)return [+m[1],+m[2],+m[3]];\\n  return [128,128,128];\\n}\\nfunction setBloco(x,y,z,c){\\n  x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);\\n  if(x<0||x>=GX||y<0||y>=GY||z<0||z>=GZ)return;\\n  var idx=x+GX*(z+GZ*y);\\n  if(c===undefined||c===null||c===0||c===''||c==='ar'){grade[idx]=0;return;}\\n  var key=String(c),k=palMap[key];\\n  if(!k){\\n    if(pal.length>=255)throw new Error('cores demais nos blocos (maximo 254)');\\n    pal.push(corRGB(c));palNome.push(key);k=pal.length-1;palMap[key]=k;\\n  }\\n  grade[idx]=k;\\n}\\nfunction getBloco(x,y,z){\\n  x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);\\n  if(x<0||x>=GX||y<0||y>=GY||z<0||z>=GZ)return 'ar';\\n  return palNome[grade[x+GX*(z+GZ*y)]];\\n}\\nfunction base3(){\\n  var yw=cam.giro*Math.PI/180,pt=cam.inc*Math.PI/180,sy=Math.sin(yw),cy=Math.cos(yw),sp=Math.sin(pt),cp=Math.cos(pt);\\n  return {fx:sy*cp,fy:sp,fz:cy*cp,rx:cy,ry:0,rz:-sy,ux:-sy*sp,uy:cp,uz:-cy*sp};\\n}\\nfunction olhar(){\\n  var b=base3(),ox=cam.x,oy=cam.y,oz=cam.z,dx=b.fx,dy=b.fy,dz=b.fz;\\n  var mx=Math.floor(ox),my=Math.floor(oy),mz=Math.floor(oz);\\n  var sx=dx<0?-1:1,sy=dy<0?-1:1,sz=dz<0?-1:1;\\n  var ddx=dx===0?Infinity:Math.abs(1/dx),ddy=dy===0?Infinity:Math.abs(1/dy),ddz=dz===0?Infinity:Math.abs(1/dz);\\n  var tx=dx===0?Infinity:(dx>0?mx+1-ox:ox-mx)*ddx,ty=dy===0?Infinity:(dy>0?my+1-oy:oy-my)*ddy,tz=dz===0?Infinity:(dz>0?mz+1-oz:oz-mz)*ddz;\\n  var t=0,px,py,pz;\\n  for(var i=0;i<64;i++){\\n    px=mx;py=my;pz=mz;\\n    if(tx<ty){if(tx<tz){mx+=sx;t=tx;tx+=ddx;}else{mz+=sz;t=tz;tz+=ddz;}}\\n    else{if(ty<tz){my+=sy;t=ty;ty+=ddy;}else{mz+=sz;t=tz;tz+=ddz;}}\\n    if(t>6)break;\\n    if(mx>=0&&mx<GX&&my>=0&&my<GY&&mz>=0&&mz<GZ&&grade[mx+GX*(mz+GZ*my)])\\n      return {achou:true,x:mx,y:my,z:mz,ax:px,ay:py,az:pz};\\n  }\\n  return {achou:false,x:0,y:0,z:0,ax:0,ay:0,az:0};\\n}\\nfunction desenhar3D(){\\n  var w=Math.max(1,Math.ceil(canvas.width/res)),h=Math.max(1,Math.ceil(canvas.height/res));\\n  if(!off||off.width!==w||off.height!==h){\\n    off=document.createElement('canvas');off.width=w;off.height=h;octx=off.getContext('2d');\\n    img3=octx.createImageData(w,h);px32=new Uint32Array(img3.data.buffer);\\n  }\\n  var b=base3(),ox=cam.x,oy=cam.y,oz=cam.z,ft=Math.tan(fov*Math.PI/360),asp=w/h;\\n  var sR=sky[0],sG=sky[1],sB=sky[2],idx=0;\\n  var mx0=Math.floor(ox),my0=Math.floor(oy),mz0=Math.floor(oz);\\n  for(var py=0;py<h;py++){\\n    var v=(1-2*(py+0.5)/h)*ft,gr=0.8+0.2*(py/h);\\n    var skyPix=(255<<24)|((sB*gr)<<16)|((sG*gr)<<8)|(sR*gr);\\n    for(var pxl=0;pxl<w;pxl++,idx++){\\n      var u=(2*(pxl+0.5)/w-1)*ft*asp;\\n      var dx=b.fx+b.rx*u+b.ux*v,dy=b.fy+b.ry*u+b.uy*v,dz=b.fz+b.rz*u+b.uz*v;\\n      var mx=mx0,my=my0,mz=mz0;\\n      var sx=dx<0?-1:1,sy=dy<0?-1:1,sz=dz<0?-1:1;\\n      var ddx=dx===0?Infinity:Math.abs(1/dx),ddy=dy===0?Infinity:Math.abs(1/dy),ddz=dz===0?Infinity:Math.abs(1/dz);\\n      var tx=dx===0?Infinity:(dx>0?mx+1-ox:ox-mx)*ddx,ty=dy===0?Infinity:(dy>0?my+1-oy:oy-my)*ddy,tz=dz===0?Infinity:(dz>0?mz+1-oz:oz-mz)*ddz;\\n      var t=0,side=0,hit=0;\\n      for(var s=0;s<96;s++){\\n        if(tx<ty){if(tx<tz){mx+=sx;t=tx;tx+=ddx;side=0;}else{mz+=sz;t=tz;tz+=ddz;side=2;}}\\n        else{if(ty<tz){my+=sy;t=ty;ty+=ddy;side=1;}else{mz+=sz;t=tz;tz+=ddz;side=2;}}\\n        if(t>maxD)break;\\n        if(mx>=0&&mx<GX&&my>=0&&my<GY&&mz>=0&&mz<GZ){hit=grade[mx+GX*(mz+GZ*my)];if(hit)break;}\\n      }\\n      if(!hit){px32[idx]=skyPix;continue;}\\n      var f=side===1?(sy<0?1:0.55):(side===0?0.8:0.65);\\n      var f1,f2;\\n      if(side===0){f1=oy+dy*t;f2=oz+dz*t;}else if(side===1){f1=ox+dx*t;f2=oz+dz*t;}else{f1=ox+dx*t;f2=oy+dy*t;}\\n      f1-=Math.floor(f1);f2-=Math.floor(f2);\\n      if(Math.min(f1,1-f1,f2,1-f2)<0.04)f*=0.78;\\n      f*=0.9+0.1*(((mx*73856093)^(my*19349663)^(mz*83492791))&255)/255;\\n      var fg=t/maxD;fg=fg*fg*0.7;\\n      var c=pal[hit];\\n      var r=(c[0]*f)*(1-fg)+sR*fg,g=(c[1]*f)*(1-fg)+sG*fg,bl=(c[2]*f)*(1-fg)+sB*fg;\\n      px32[idx]=(255<<24)|(bl<<16)|(g<<8)|r;\\n    }\\n  }\\n  octx.putImageData(img3,0,0);\\n  ctx.imageSmoothingEnabled=false;\\n  ctx.drawImage(off,0,0,canvas.width,canvas.height);\\n  ctx.fillStyle=corAtual;ctx.strokeStyle=corAtual;\\n}\\n// ---------- funcoes prontas ----------\\nB.pi=Math.PI;B.largura=canvas.width;B.altura=canvas.height;B.dt=0.016;\\nB.mouseX=0;B.mouseY=0;B.mouseDX=0;B.mouseDY=0;B.clicando=false;B.clicandoDireito=false;B.clicouEsq=false;B.clicouDir=false;B.rodinha=0;\\nB.aleatorio=function(a,b){if(b===undefined){b=a-1;a=0;}return a+Math.floor(Math.random()*(b-a+1));};\\nB.piso=Math.floor;B.teto=Math.ceil;B.arredondar=Math.round;B.raiz=Math.sqrt;B.potencia=Math.pow;B.abs=Math.abs;B.minimo=Math.min;B.maximo=Math.max;\\nB.seno=function(g){return Math.sin(g*Math.PI/180);};\\nB.cosseno=function(g){return Math.cos(g*Math.PI/180);};\\nB.tangente=function(g){return Math.tan(g*Math.PI/180);};\\nB.tamanho=function(x){return x.length;};\\nB.texto=function(x){return fmt(x);};\\nB.numero=function(x){return Number(x);};\\nB.lista=function(n,v){var l=[];for(var i=0;i<n;i++)l.push(v===undefined?0:v);return l;};\\nB.agora=function(){return Date.now();};\\nB.tecla=function(n){return !!teclas[norm(n)];};\\nB.apertou=function(n){return !!apertadas[norm(n)];};\\nB.bloco=getBloco;\\nB.olhar=olhar;\\n// ---------- laco principal ----------\\nfunction mostrarErro(e){\\n  parado=true;\\n  var msg=(e.linha?'Erro na linha '+e.linha+': ':'Erro: ')+traduzir(e);\\n  try{console.error(msg);}catch(x){}\\n  ctx.save();ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);\\n  ctx.fillStyle='#c62828';ctx.font='20px Consolas, monospace';ctx.textBaseline='top';\\n  var palavras=msg.split(' '),linha='',y=20;\\n  for(var i=0;i<palavras.length;i++){\\n    var t=linha?linha+' '+palavras[i]:palavras[i];\\n    if(ctx.measureText(t).width>canvas.width-40&&linha){ctx.fillText(linha,20,y);y+=28;linha=palavras[i];}else linha=t;\\n  }\\n  ctx.fillText(linha,20,y);ctx.restore();\\n}\\nvar ultimo=0;\\nfunction quadro(ts){\\n  if(parado)return;\\n  var d=ultimo?Math.min(0.1,(ts-ultimo)/1000):0.016;ultimo=ts;\\n  B.dt=d;B.mouseX=mouseX;B.mouseY=mouseY;B.mouseDX=mouseDX;B.mouseDY=mouseDY;\\n  B.clicando=botEsq;B.clicandoDireito=botDir;B.clicouEsq=cliqueEsq;B.clicouDir=cliqueDir;B.rodinha=roda;\\n  passos=0;\\n  try{\\n    if(autoLimpar)limpar();\\n    for(var i=0;i<handlers.length;i++)exec(handlers[i].corpo,handlers[i].esc);\\n  }catch(e){mostrarErro(e);return;}\\n  desenharTexto();\\n  mouseDX=0;mouseDY=0;cliqueEsq=false;cliqueDir=false;roda=0;apertadas={};\\n  requestAnimationFrame(quadro);\\n}\\nfunction comecar(){\\n  try{\\n    var arvore=parsear(codigo);\\n    limpar();\\n    passos=0;\\n    exec(arvore,TOPO);\\n    desenharTexto();\\n    if(handlers.length)requestAnimationFrame(quadro);\\n  }catch(e){mostrarErro(e);}\\n}\\n// carrega antes as imagens citadas no codigo\\nvar achadas=[],rx=/[\\\"']([^\\\"']+\\\\.(?:png|jpe?g|gif|webp|svg|bmp)(?:\\\\?[^\\\"']*)?)[\\\"']/gi,mm;\\nwhile((mm=rx.exec(codigo)))achadas.push(mm[1]);\\nif(!achadas.length)comecar();\\nelse{\\n  var falta=achadas.length,feito=false;\\n  var fim=function(){if(!feito&&--falta<=0){feito=true;comecar();}};\\n  achadas.forEach(function(s){var im=imagem(s);if(im.complete)fim();else{im.onload=fim;im.onerror=fim;}});\\n  setTimeout(function(){if(!feito){feito=true;comecar();}},3000);\\n}\\nwindow.__luigi={quadro:quadro,teclas:teclas,B:B};\\n}\\n\\nvar CODIGO=\\\"/*CODIGO*/\\\";\\niniciarLuigi(CODIGO);\\n<\\/script><\\/body><\\/html>\\n\";\nfunction lit(s){return s.replace(/\\\\/g,'\\\\\\\\').replace(/\"/g,'\\\\\"').replace(/\\r?\\n/g,'\\\\n').replace(/<\\//g,'<\\\\/')}\nfunction I(){var c=t.value,w=open('','_blank','width=960,height=640');\nvar a=document.createElement('a');a.href=URL.createObjectURL(new Blob([c],{type:'text/plain'}));a.download='programa.luigi';a.click();\nif(!w){alert('Permita pop-ups neste arquivo para executar o programa.');return}\nw.document.open();w.document.write(TPL.split('/*NOME*/').join('Luigi').split('/*BASE*/').join('').split('/*CODIGO*/').join(lit(c)));w.document.close()}\nfunction M(i){var f=i.files[0],d=new FileReader;d.onload=function(){t.value=d.result};d.readAsText(f)}\n<\/script>\n";
var EXEMPLO="// Meu primeiro programa em Luigi (tela branca, so o que voce mandar)\n/fundo/ \"white\" /\n/criar/ \"Ola, mundo!\" /\n/var/ nome = \"Mario\" /\n/criar/ \"Oi,\", nome /\n\n/cor/ \"red\" /\n/retangulo/ 50, 120, 200, 80 /\n/cor/ 0, 120, 255 /\n/circulo/ 400, 160, 50 /\n/cor/ \"black\" /\n/escrever/ \"Isso e Luigi!\", 50, 240, 28 /\n\n/funcao/ dobro(n) /\n    /retornar/ n * 2 /\n/fim/ /\n/criar/ \"O dobro de 21 e\", dobro(21) /\n\n/var/ soma = 0 /\n/para/ i de 1 ate 5 /\n    /var/ soma += i /\n/fim/ /\n/criar/ \"Soma de 1 a 5:\", soma /\n";
var MINECRAFT="// MINECRAFT EM LUIGI\n// WASD andar | mouse olhar (clique para travar) | ESPACO pular\n// botao esquerdo quebra | botao direito coloca | teclas 1 a 6 trocam o bloco\n\n/ceu/ \"#87ceeb\" /\n/resolucao/ 5 /\n\n/funcao/ terreno(x, z) /\n    /retornar/ 8 + piso(seno(x * 12) * 2 + seno(z * 9) * 2 + seno((x + z) * 6)) /\n/fim/ /\n\n// gera o mundo\n/para/ x de 0 ate 63 /\n    /para/ z de 0 ate 63 /\n        /var/ h = terreno(x, z) /\n        /preencher/ x, 0, z, x, h - 3, z, \"#9e9e9e\" /\n        /preencher/ x, h - 2, z, x, h - 1, z, \"#8d6e63\" /\n        /bloco/ x, h, z, \"#4caf50\" /\n    /fim/ /\n/fim/ /\n\n// arvores\n/repetir/ 25 /\n    /var/ ax = aleatorio(4, 59) /\n    /var/ az = aleatorio(4, 59) /\n    /var/ ah = terreno(ax, az) /\n    /preencher/ ax, ah + 1, az, ax, ah + 4, az, \"#6d4c41\" /\n    /preencher/ ax - 2, ah + 4, az - 2, ax + 2, ah + 5, az + 2, \"#2e7d32\" /\n    /preencher/ ax - 1, ah + 6, az - 1, ax + 1, ah + 6, az + 1, \"#388e3c\" /\n/fim/ /\n\n/var/ cores = [\"#4caf50\", \"#8d6e63\", \"#9e9e9e\", \"#ffeb3b\", \"#f44336\", \"#ffffff\"] /\n/var/ sel = 0 /\n/var/ px = 32.5 /\n/var/ pz = 32.5 /\n/var/ py = terreno(32, 32) + 3 /\n/var/ vy = 0 /\n/var/ giro = 0 /\n/var/ inc = 0 /\n/var/ noChao = falso /\n\n/funcao/ solido(x, y, z) /\n    /retornar/ bloco(x, y, z) != \"ar\" /\n/fim/ /\n\n/funcao/ parede(x, y, z) /\n    /retornar/ solido(x, y - 1.4, z) ou solido(x, y - 0.4, z) ou solido(x, y + 0.1, z) /\n/fim/ /\n\n/sempre/ /\n    // olhar com o mouse\n    /var/ giro += mouseDX * 0.15 /\n    /var/ inc = maximo(-89, minimo(89, inc - mouseDY * 0.15)) /\n\n    // andar\n    /var/ mx = 0 /\n    /var/ mz = 0 /\n    /se/ tecla(\"w\") /\n        /var/ mx += seno(giro) /\n        /var/ mz += cosseno(giro) /\n    /fim/ /\n    /se/ tecla(\"s\") /\n        /var/ mx -= seno(giro) /\n        /var/ mz -= cosseno(giro) /\n    /fim/ /\n    /se/ tecla(\"d\") /\n        /var/ mx += cosseno(giro) /\n        /var/ mz -= seno(giro) /\n    /fim/ /\n    /se/ tecla(\"a\") /\n        /var/ mx -= cosseno(giro) /\n        /var/ mz += seno(giro) /\n    /fim/ /\n    /var/ nx = px + mx * 4.5 * dt /\n    /se/ nao parede(nx, py, pz) /\n        /var/ px = nx /\n    /fim/ /\n    /var/ nz = pz + mz * 4.5 * dt /\n    /se/ nao parede(px, py, nz) /\n        /var/ pz = nz /\n    /fim/ /\n\n    // pular e gravidade\n    /se/ apertou(\"espaco\") e noChao /\n        /var/ vy = 8 /\n    /fim/ /\n    /var/ vy -= 22 * dt /\n    /var/ ny = py + vy * dt /\n    /var/ noChao = falso /\n    /se/ vy < 0 /\n        /se/ solido(px, ny - 1.6, pz) /\n            /var/ py = piso(ny - 1.6) + 1 + 1.6 /\n            /var/ vy = 0 /\n            /var/ noChao = verdadeiro /\n        /senao/ /\n            /var/ py = ny /\n        /fim/ /\n    /senao/ /\n        /se/ solido(px, ny + 0.2, pz) /\n            /var/ vy = 0 /\n        /senao/ /\n            /var/ py = ny /\n        /fim/ /\n    /fim/ /\n    /se/ py < -20 /\n        /var/ py = 30 /\n        /var/ vy = 0 /\n    /fim/ /\n\n    // escolher bloco\n    /para/ k de 0 ate 5 /\n        /se/ apertou(texto(k + 1)) /\n            /var/ sel = k /\n        /fim/ /\n    /fim/ /\n\n    // quebrar e colocar\n    /camera/ px, py, pz, giro, inc /\n    /var/ alvo = olhar() /\n    /se/ alvo.achou /\n        /se/ clicouEsq /\n            /bloco/ alvo.x, alvo.y, alvo.z, \"ar\" /\n        /fim/ /\n        /se/ clicouDir /\n            /var/ dentro = piso(px) == alvo.ax e piso(pz) == alvo.az e (piso(py - 1.4) == alvo.ay ou piso(py - 0.4) == alvo.ay) /\n            /se/ nao dentro /\n                /bloco/ alvo.ax, alvo.ay, alvo.az, cores[sel] /\n            /fim/ /\n        /fim/ /\n    /fim/ /\n\n    /desenhar3d/ /\n\n    // mira e informacoes\n    /cor/ \"white\" /\n    /linha/ largura / 2 - 9, altura / 2, largura / 2 + 9, altura / 2 /\n    /linha/ largura / 2, altura / 2 - 9, largura / 2, altura / 2 + 9 /\n    /cor/ cores[sel] /\n    /retangulo/ 12, altura - 44, 32, 32 /\n    /cor/ \"white\" /\n    /escrever/ \"WASD andar | ESPACO pular | esq quebrar | dir colocar | 1-6 bloco\", 54, altura - 38, 18 /\n/fim/ /\n";
function escrever(caminho,texto){
  var fso=new ActiveXObject('Scripting.FileSystemObject');
  var f=fso.CreateTextFile(caminho,true,false);
  f.Write(texto);f.Close();
}
function instalar(){
  var msg=document.getElementById('msg');
  try{
    var sh=new ActiveXObject('WScript.Shell');
    var fso=new ActiveXObject('Scripting.FileSystemObject');
    var dir=sh.ExpandEnvironmentStrings('%APPDATA%')+'\\Luigi';
    if(!fso.FolderExists(dir))fso.CreateFolder(dir);
    escrever(dir+'\\abrir.js',ABRIR_JS);
    escrever(dir+'\\modelo.html',MODELO_HTML);
    var desk=sh.SpecialFolders('Desktop');
    escrever(desk+'\\exemplo.luigi',EXEMPLO);
    escrever(desk+'\\minecraft.luigi',MINECRAFT);
    escrever(desk+'\\Luigi editor.html',MINI_HTML);
    try{if(fso.FileExists(desk+'\\Luigi.lnk'))fso.DeleteFile(desk+'\\Luigi.lnk');}catch(e2){}
    sh.RegWrite('HKCU\\Software\\Classes\\.luigi\\','LuigiFile','REG_SZ');
    sh.RegWrite('HKCU\\Software\\Classes\\LuigiFile\\','Programa Luigi','REG_SZ');
    sh.RegWrite('HKCU\\Software\\Classes\\LuigiFile\\shell\\open\\command\\','wscript.exe "'+dir+'\\abrir.js" "%1"','REG_SZ');
    msg.innerHTML='<b>PRONTO!</b> Luigi instalada.<br>Na sua &Aacute;rea de Trabalho apareceram:<br>&bull; <b>Luigi editor.html</b> (tela preta para escrever)<br>&bull; <b>exemplo.luigi</b> e <b>minecraft.luigi</b> (dois cliques para rodar)<br>Para sair de um programa em tela cheia: <b>Alt+F4</b>.';
  }catch(e){
    msg.innerHTML='Deu erro: '+e.message;
  }
}
</script>
</body>
</html>
